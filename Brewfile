# vfx-toolkit - free apps and command-line tools for day one.
# Install with:  brew bundle --file=Brewfile
# If a cask has been renamed or pulled, brew bundle reports it and carries on;
# grab that one from the vendor's site instead.

# --- command line ------------------------------------------------------------
brew "uv"             # Python + venvs, used by bootstrap.sh
brew "ffmpeg"         # encoding, HAP, ProRes
brew "openimageio"    # oiiotool, iinfo, maketx on the command line
brew "opencolorio"    # ociocheck, ocioconvert
brew "exiftool"       # metadata inspection
brew "imagemagick"    # quick image wrangling
brew "git-lfs"        # big binary files in git

# --- apps (all free) ---------------------------------------------------------
cask "blender"        # 3D
cask "davinci-resolve" # edit / grade / Fusion (free edition)
cask "touchdesigner"  # realtime / projection (free non-commercial licence)
cask "obs"            # capture and streaming
cask "djv"            # EXR / image sequence viewer with OCIO
cask "vlc"            # plays anything
